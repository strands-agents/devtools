# The SANDBOX AgentCore Runtime image — the box Strandly's shell and file tools run in.
#
# This is not the agent's image. It contains no agent, no Strands SDK and no credentials: only a
# shell and the developer tools a coding agent needs, so that `InvokeAgentRuntimeCommand` has
# something real to run. The Code Interpreter this replaces used a fixed AL2023 image with no `git`,
# which cost every fresh session a ~30-60s rootless micromamba bootstrap just to get one; here the
# tools are baked in and that bootstrap is deleted.

# Ollama's CPU runtime, unpacked in a throwaway stage.
# - The release tarball is ~1.6 GB, almost all CUDA libs; only the ~62 MB CPU subset is copied over.
# - BUILDPLATFORM: this stage only downloads and unpacks, so it skips QEMU on x86 deploy runners.
# - lib/ollama/llama-server is Ollama's pinned llama.cpp server, reused for llama.cpp tests.
FROM --platform=$BUILDPLATFORM docker.io/library/python:3.13-slim-bookworm@sha256:480c75f114c46f661eea2f337ef40672160f9989f7de0c385aa719e51c6e44da AS ollama
ARG OLLAMA_VERSION=0.40.13
ARG OLLAMA_SHA256=913d9a28da6da86d551ce4ca531457767bb14d511cbc1d5ca93e9b3b8b9a8666
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl zstd \
    && curl -fsSL "https://github.com/ollama/ollama/releases/download/v${OLLAMA_VERSION}/ollama-linux-arm64.tar.zst" \
      -o /tmp/ollama.tar.zst \
    && echo "${OLLAMA_SHA256}  /tmp/ollama.tar.zst" | sha256sum -c - \
    && mkdir /opt/ollama \
    && tar --zstd -xf /tmp/ollama.tar.zst -C /opt/ollama --exclude='lib/ollama/cuda_*'

# ARM64 because AgentCore Runtime runs arm64.
# Use the official upstream at the identical digest; the public ECR mirror hit its pull quota.
FROM docker.io/library/python:3.13-slim-bookworm@sha256:480c75f114c46f661eea2f337ef40672160f9989f7de0c385aa719e51c6e44da

# - git / openssh-client: clone, fetch, push (the agent's whole job)
# - ca-certificates: TLS for git/https and the AWS SDK
# - tar + gzip: the skills push is one archive (skills/loader.py)
# - ripgrep: `bash` is the only search tool the agent has; `rg` is what makes it usable
# - curl, jq, less-free: ordinary shell ergonomics. No pager is installed on purpose — the harness
#   pins GIT_PAGER=cat, and a pager in a non-interactive shell is a hang waiting to happen.
# - xz-utils / bzip2 / patch: the Node tarball below is .tar.xz, and release archives the agent
#   unpacks are routinely .tar.xz or .tar.bz2; `patch` applies a diff outside a git checkout.
#   build-essential used to pull all three in through dpkg-dev; they are listed on their own now.
# - gcc / g++ / make / libc6-dev: enough of a toolchain for `pip install` (and node-gyp) of packages
#   with C/C++ extensions. This is build-essential minus dpkg-dev, which only builds .debs and
#   drags in its Perl tooling; nothing the agent does needs it. (The image size budget is enforced
#   by scripts/check_sandbox_image_size.py — a bigger image is a slower cold start.)
# - tini: PID 1 (see ENTRYPOINT). An orphaned process is reparented to PID 1, and Python never
#   reaps it; the service counts a command as running until every process it started is gone,
#   zombies included, and a session container has 197 command slots.
# - pkg-config / libssl-dev / portaudio19-dev: headers that source builds look for (Rust's openssl-sys,
#   pyaudio). The sandbox user has no root, so a missing -dev package cannot be added at run time.
# - fd-find (as `fd`), unzip / zip, rsync, sqlite3: small, and otherwise fetched by hand.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git openssh-client ca-certificates tar gzip xz-utils bzip2 patch curl jq ripgrep \
        gcc g++ make libc6-dev tini \
        pkg-config libssl-dev portaudio19-dev fd-find unzip zip rsync sqlite3 \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# Node for JS/TS repos, from the distro-independent official tarball (nodesource is heavier and adds
# an apt key to manage).
ARG NODE_VERSION=22.14.0
RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-arm64.tar.xz" \
      -o /tmp/node.tar.xz \
    && tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 \
    && rm /tmp/node.tar.xz \
    && node --version && npm --version

# pnpm and yarn through corepack, which fetches the version a repo pins (or the latest) on first use.
# Node 22.14 bundles corepack 0.31, which cannot run pnpm 12, so a pinned, sha256-checked newer one
# replaces it.
ARG COREPACK_VERSION=0.36.0
ARG COREPACK_SHA256=9128cfe26aee0c99f4fc68c15c6b8b12309a68be0de2c012cdfea2a463cb722f
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN curl -fsSL "https://registry.npmjs.org/corepack/-/corepack-${COREPACK_VERSION}.tgz" -o /tmp/corepack.tgz \
    && echo "${COREPACK_SHA256}  /tmp/corepack.tgz" | sha256sum -c - \
    && npm install --global --no-audit --no-fund /tmp/corepack.tgz \
    && corepack enable pnpm yarn \
    && corepack --version \
    && rm -rf /tmp/corepack.tgz /root/.npm

# Headless Chromium for browser checks (harness-sdk's docs-diagrams skill screenshots its diagrams
# with Playwright). The sandbox user has no root, so without this every session hand-assembled the
# OS libs from .debs plus a user-space fontconfig: ~1 GB of downloads per fresh session.
# - The libs are Playwright's debian12 `chromium` list; skipping its `tools` list (xvfb, CJK fonts)
#   saves ~400 MB that headless runs don't use.
# - Fonts are not optional: with none, Chromium draws every text label as blank. Liberation gives
#   Arial/Helvetica metrics, DejaVu is the fallback, fontconfig provides `fc-list`.
# - PLAYWRIGHT_VERSION tracks harness-sdk's package-lock. A repo on the same version finds the
#   browser on its own; on another version, PLAYWRIGHT_CHROMIUM_EXECUTABLE (read by the skill's
#   screenshot.mjs) still points at a working binary. The browsers dir is uid 1000 (the `sandbox`
#   user below) so `npx playwright install` can still add another revision. chown in this same
#   layer, or it duplicates the browser.
ARG PLAYWRIGHT_VERSION=1.61.1
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/local/bin/chromium-headless-shell
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 libdbus-1-3 \
        libdrm2 libgbm1 libglib2.0-0 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 \
        libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
        fontconfig fonts-liberation fonts-dejavu-core fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/* \
    && npx -y "playwright@${PLAYWRIGHT_VERSION}" install --only-shell chromium \
    && ln -s "$(find "$PLAYWRIGHT_BROWSERS_PATH" -type f -name 'chrome-headless-shell' -o -type f -name 'headless_shell' | head -1)" \
        "$PLAYWRIGHT_CHROMIUM_EXECUTABLE" \
    && "$PLAYWRIGHT_CHROMIUM_EXECUTABLE" --version \
    && chown -R 1000:1000 "$PLAYWRIGHT_BROWSERS_PATH" \
    && rm -rf /root/.npm /root/.cache /tmp/*

# uv: the harness's own projects are uv-managed, and `uvx` is how the agent runs one-off tools.
# Pin the patched trust store; changing this input also rebuilds the CDK image asset.
COPY --from=ghcr.io/astral-sh/uv:0.13.4 /uv /uvx /usr/local/bin/

# awscli: skills drive AWS from the shell (e.g. `aws s3 ls` under an operator-selected profile).
# pip's awscli (v1) is pure Python — arm64-safe with no platform wheel to chase — at ~15 MB.
# Pinned; changing this input also rebuilds the CDK image asset.
RUN pip install --no-cache-dir awscli==1.46.3

# gh, from the pinned release tarball (its sha256 below; the tarball's GitHub build provenance passes
# `gh attestation verify --repo cli/cli`). No credential is configured on purpose: the agent's GitHub
# token never reaches the sandbox, and GitHub changes go through the agent's `use_github` tool.
ARG GH_VERSION=2.105.0
ARG GH_SHA256=b1278c75107423d818f1937fd92cafc9e5e9b606631568f68d7fb816f5885a02
ENV GH_NO_UPDATE_NOTIFIER=1 \
    GH_PROMPT_DISABLED=1
RUN curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_arm64.tar.gz" \
      -o /tmp/gh.tar.gz \
    && echo "${GH_SHA256}  /tmp/gh.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/gh.tar.gz -C /usr/local/bin --strip-components=2 "gh_${GH_VERSION}_linux_arm64/bin/gh" \
    && rm /tmp/gh.tar.gz \
    && gh --version

# rustup only: a baked minimal toolchain (~175 MB compressed) would slow every cold start, so
# `rustup toolchain install` fetches RUST_TOOLCHAIN (or a repo's rust-toolchain.toml) in ~10-30 s.
# Auto-install is off: pip runs `rustc --version` for its user agent, which would start a download.
ARG RUSTUP_VERSION=1.29.3
ARG RUSTUP_SHA256=9f608c142e0e38a78957d0661ba1dfaf0b6fb37184cfaa4b9a0aa57af6184282
ARG RUST_TOOLCHAIN=1.100.0
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN install -d -o 1000 -g 1000 "$RUSTUP_HOME" "$CARGO_HOME"
# As uid 1000 (the `sandbox` user below, no passwd entry yet, hence HOME=/tmp), so the sandbox user
# owns every rustup dir. settings.toml is rustup 1.29's schema 12.
USER 1000:1000
RUN curl -fsSL "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/aarch64-unknown-linux-gnu/rustup-init" \
      -o /tmp/rustup-init \
    && echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && HOME=/tmp /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain none \
    && rm /tmp/rustup-init \
    && printf '%s\n' 'version = "12"' "default_toolchain = \"${RUST_TOOLCHAIN}\"" 'profile = "minimal"' \
        'auto_self_update = "disable"' 'auto_install = "disable"' '' '[overrides]' \
        > "$RUSTUP_HOME/settings.toml" \
    && HOME=/tmp rustup --version \
    && test ! -e "$RUSTUP_HOME/toolchains"
USER root

# The runtime contract server. ONLY bedrock-agentcore — see sandbox_main.py on why this image must
# not import the harness.
COPY requirements-sandbox.txt /app/requirements-sandbox.txt
RUN pip install --no-cache-dir -r /app/requirements-sandbox.txt

COPY sandbox_main.py /app/sandbox_main.py
COPY strandly_sandbox_auth.py strandly_sandbox_auth.mjs /opt/strandly/

# Local Ollama + llama.cpp for model-provider tests (docs/sandbox.md#local-models). No models baked in.
COPY --from=ollama /opt/ollama /opt/ollama
COPY --chmod=755 strandly_local_llm.sh /opt/strandly/local-llm
ENV PATH=/opt/ollama/bin:$PATH

# Non-root. /mnt/workspace is where the service mounts the session's persistent EBS volume (on
# Runtime instances); the image's own dir is chowned so the agent can write to it
# without sudo (the Code Interpreter's non-root-with-no-sudo shell is what forced the micromamba
# workaround, and repeating that mistake here would be a choice).
RUN useradd --create-home --uid 1000 sandbox \
    && mkdir -p /mnt/workspace \
    && ln -s /mnt/workspace /home/sandbox/work \
    && chown -R sandbox:sandbox /mnt/workspace /app
USER sandbox
WORKDIR /mnt/workspace

ENV PYTHONPATH=/opt/strandly \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    GIT_TERMINAL_PROMPT=0 \
    GIT_PAGER=cat \
    PAGER=cat \
    DEBIAN_FRONTEND=noninteractive \
    STRANDLY_SANDBOX_WORKSPACE=/mnt/workspace

# The AgentCore Runtime service contract: HTTP on 8080 with /invocations and /ping.
EXPOSE 8080
# tini reaps orphans, forwards signals to sandbox_main.py and exits with its status.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "/app/sandbox_main.py"]
